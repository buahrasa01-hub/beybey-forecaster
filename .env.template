# Copy to .env and fill in. .env is local-only; never commit it.
# Metaculus bot token: metaculus.com -> Settings -> My Forecasting Bots ->
# (create bot) -> copy the access token. Required for API reads AND writes.
METACULUS_TOKEN=
# OpenRouter key (optional here — run.sh also reads ~/.openrouter/key).
OPENROUTER_API_KEY=
# Free model slug (verified working 2026-11-10; free slugs rotate over time).
# Override if you later use sponsored credits.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
